DEPLOYMENT_ENV=staging
APP_ENV=staging
PROJECT_NAME=claimmate-staging
POSTGRES_DB=claimmate
POSTGRES_USER=claimmate
POSTGRES_PASSWORD=change-me
DATABASE_SCHEMA=claimmate
CLAIMMATE_API_IMAGE=ghcr.io/ikriel-droid/claimmate-ai-api:staging
CLAIMMATE_WEB_IMAGE=ghcr.io/ikriel-droid/claimmate-ai-web:staging
API_PORT=8000
REDIS_PORT=6379
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
PUBLIC_DOMAIN=staging.claimmate.example.com
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
SESSION_SECRET_KEY=replace-me
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://claimmate:change-me@postgres:5432/claimmate
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=https://staging.claimmate.example.com/api/integrations/cafe24/callback
CAFE24_WEBHOOK_SECRET=
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=
REPLY_DELIVERY_MODE=webhook
REPLY_DELIVERY_WEBHOOK_URL=
REPLY_DELIVERY_WEBHOOK_TOKEN=
SEED_DEMO_DATA=false
AUTO_CREATE_TABLES=false
