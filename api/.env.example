APP_ENV=development
API_PREFIX=/api
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
BACKGROUND_JOB_WORKER_ENABLED=true
BACKGROUND_JOB_POLL_SECONDS=1.5
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_JOB_RETRY_BASE_SECONDS=5
BACKGROUND_JOB_RETRY_MAX_SECONDS=120
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEFAULT_MERCHANT_ID=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SESSION_SECRET_KEY=claimmate-local-session-secret
SESSION_COOKIE_NAME=claimmate_session
SESSION_MAX_AGE_SECONDS=43200
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/cafe24/callback
CAFE24_WEBHOOK_SECRET=
CAFE24_SCOPES=
CAFE24_API_TIMEOUT_SECONDS=15
REPLY_DELIVERY_MODE=manual_handoff
REPLY_DELIVERY_WEBHOOK_URL=
REPLY_DELIVERY_WEBHOOK_TOKEN=
REPLY_DELIVERY_TIMEOUT_SECONDS=10
REPLY_DELIVERY_MANUAL_CHANNEL_LABEL=Cafe24 Admin Manual Handoff
SEED_DEMO_DATA=true
