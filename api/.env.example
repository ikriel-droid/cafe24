APP_ENV=development
API_PREFIX=/api
DATABASE_URL=
DATABASE_SCHEMA=claimmate
AUTO_CREATE_TABLES=true
REDIS_URL=redis://127.0.0.1:6379/0
BACKGROUND_JOB_WORKER_ENABLED=true
BACKGROUND_JOB_POLL_SECONDS=1.5
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_JOB_RETRY_BASE_SECONDS=5
BACKGROUND_JOB_RETRY_MAX_SECONDS=120
CLAIM_RETENTION_DAYS=90
SLOW_REQUEST_THRESHOLD_MS=1000
OBSERVABILITY_MAX_EVENTS=50
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=
OBSERVABILITY_ALERT_TIMEOUT_SECONDS=5
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
CAFE24_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
SERVICE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SERVICE_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEFAULT_MERCHANT_ID=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_INPUT_COST_PER_1M_TOKENS=
OPENAI_OUTPUT_COST_PER_1M_TOKENS=
SESSION_SECRET_KEY=claimmate-local-session-secret
SESSION_COOKIE_NAME=claimmate_session
SESSION_MAX_AGE_SECONDS=43200
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/cafe24/callback
CAFE24_WEBHOOK_SECRET=
CAFE24_SCOPES=
CAFE24_API_TIMEOUT_SECONDS=15
REPLY_DELIVERY_MODE=manual_handoff
REPLY_DELIVERY_WEBHOOK_URL=
REPLY_DELIVERY_WEBHOOK_TOKEN=
REPLY_DELIVERY_TIMEOUT_SECONDS=10
REPLY_DELIVERY_MANUAL_CHANNEL_LABEL=Cafe24 Admin Manual Handoff
SEED_DEMO_DATA=true
